{
  "name": "intro-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:speakwise": "NEXT_PUBLIC_SPEAKWISE_API_URL=http://127.0.0.1:8000 next dev",
    "dev:speakwise-api": "api/speakwise/.venv/bin/uvicorn main:app --app-dir api/speakwise --host 127.0.0.1 --port 8000",
    "dev:speakwise-api:reload": "api/speakwise/.venv/bin/uvicorn main:app --reload --reload-dir api/speakwise --app-dir api/speakwise --host 127.0.0.1 --port 8000",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --test --experimental-strip-types apps/vocabstream/src/lib/learning.test.ts",
    "test:browser": "node scripts/validate-frontend.mjs",
    "test:backend": "node --test --experimental-strip-types app/api/_lib/http.test.ts lib/browserRequest.test.ts apps/vocabstream/src/lib/progressContract.test.ts apps/vidmatch/src/services/videoContract.test.ts apps/speakwise/src/lib/*.test.ts",
    "test:speakwise-api": "api/speakwise/.venv/bin/python -m unittest discover -s api/speakwise/tests -v",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/analytics": "^1.5.0",
    "next": "15.5.26",
    "next-sitemap": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18 <27"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
